{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When source files change (shell scripts, Terraform, config files, HTML, Dockerfiles, SQL), ask the agent to update README.md or any relevant docs to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.sh",
      "**/*.tf",
      "**/*.toml",
      "**/*.html",
      "**/Dockerfile",
      "**/*.sql",
      "**/docker-compose.yml",
      "**/*.yml",
      "**/*.yaml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and update the documentation to reflect it. Check README.md first — if the change affects usage, configuration, deployment, or features described there, update it. Also check FEATURES.md, DEPLOYMENT_OPTIONS.md, QUICKSTART.md, and SUMMARY.md for any sections that may need updating. Keep docs accurate and in sync with the current state of the code."
  }
}